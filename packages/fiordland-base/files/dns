#!/usr/bin/env bash
set -euo pipefail
CONF=/etc/systemd/resolved.conf.d/50-fiordland-tls.conf
STUB=/run/systemd/resolve/stub-resolv.conf

usage() {
  cat <<USAGE
usage: fiordland dns [tls | default]

tls       encrypted DNS (DNS over TLS) through systemd-resolved, using Quad9
          and Cloudflare. Lookups fail rather than fall back to plain DNS.
default   the DNS servers your network hands out, unencrypted.
Without an argument, shows the current mode.
USAGE
  exit "${1:-0}"
}

case ${1:-} in
  "")
    if [ -f "$CONF" ]; then echo tls; else echo default; fi
    ;;
  -h|--help) usage ;;
  tls)
    [ "$(id -u)" -eq 0 ] || exec sudo /usr/lib/fiordland/dns "$@"
    install -d -m755 "${CONF%/*}"
    tmp=$(mktemp "$CONF.XXXXXX")
    printf '%s\n' '[Resolve]' \
      'DNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com' \
      'DNSOverTLS=yes' 'Domains=~.' > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$CONF"
    systemctl enable --now systemd-resolved.service
    systemctl restart systemd-resolved.service
    if [ "$(readlink /etc/resolv.conf 2>/dev/null || true)" != "$STUB" ]; then
      [ -e /etc/resolv.conf ] && cp -aP /etc/resolv.conf /etc/resolv.conf.fiordland-old
      ln -sfn "$STUB" /etc/resolv.conf
      systemctl try-restart NetworkManager.service
    fi
    echo "Encrypted DNS is on. Undo: sudo fiordland dns default"
    ;;
  default)
    [ "$(id -u)" -eq 0 ] || exec sudo /usr/lib/fiordland/dns "$@"
    rm -f "$CONF"
    systemctl try-restart systemd-resolved.service
    echo "DNS uses your network's servers again."
    ;;
  *) usage 2 ;;
esac
