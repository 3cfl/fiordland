BUILD_FLAGS=()
_lto_deps=(clang llvm lld)
case "$_use_llvm_lto" in
  none) ;;
  thin|full)
    makedepends+=("${_lto_deps[@]}")
    BUILD_FLAGS=(CC=clang LD=ld.lld LLVM=1 LLVM_IAS=1)
    source+=("dkms-clang.patch::${_patchsource}/misc/dkms-clang.patch")
    sha256sums+=('6f45ef083841792e88fbadbfefb0630abd738a131f9782333fbc61f8b6712b4b')
    b2sums+=('c992567bd7dd8553432be496ffa1c17e2f5ebe9c7edb51945cf977e1b742dd6517c210d8843bb82744ca705efd07f8027cd7dde41b50215ebd707a34aa81462e')
    ;;
esac

export KBUILD_BUILD_HOST=fiordland
export KBUILD_BUILD_USER="$pkgbase"
if [ -n "${SOURCE_DATE_EPOCH:-}" ]; then
  KBUILD_BUILD_TIMESTAMP="$(date -Rud "@$SOURCE_DATE_EPOCH")"
else
  KBUILD_BUILD_TIMESTAMP="$(date -Ru)"
fi
export KBUILD_BUILD_TIMESTAMP

_die() {
  error "$@"
  exit 1
}

_check_config() {
  local key val bad=0
  while IFS='=' read -r key val; do
    [ -n "$key" ] || continue
    if [ "$val" = n ]; then
      if grep -q -- "^${key}=" .config; then
        error "$key is still enabled"
        bad=1
      fi
    elif ! grep -qxF -- "${key}=${val}" .config; then
      error "$key=$val did not stick, got: $(grep -- "^${key}=" .config || echo unset)"
      bad=1
    fi
  done < "$1"
  [ "$bad" = 0 ] || _die "fiord.config was not applied cleanly"
}

prepare() {
  cd "$_srcname"

  echo "-$pkgrel" > localversion.10-pkgrel

  local entry name
  for entry in "${source[@]}"; do
    name="${entry%%::*}"
    name="${name##*/}"
    [[ $name = *.patch ]] || continue
    msg2 "Applying $name"
    patch -Np1 -i "../$name"
  done

  cp ../config .config
  scripts/kconfig/merge_config.sh -m .config ../fiord.config

  local march="${_processor_opt^^}"
  case "$march" in
    GENERIC_V[1-4])
      scripts/config -e GENERIC_CPU -d MZEN4 -d X86_NATIVE_CPU --set-val X86_64_VERSION "${march#GENERIC_V}" ;;
    ZEN4) scripts/config -d GENERIC_CPU -e MZEN4 -d X86_NATIVE_CPU ;;
    NATIVE) scripts/config -d GENERIC_CPU -d MZEN4 -e X86_NATIVE_CPU ;;
    *) _die "_processor_opt '$_processor_opt' is not one of generic_v1..generic_v4, zen4, native" ;;
  esac

  case "$_use_llvm_lto" in
    none) scripts/config -e LTO_NONE -d LTO_CLANG_THIN -d LTO_CLANG_FULL ;;
    thin) scripts/config -d LTO_NONE -e LTO_CLANG_THIN -d LTO_CLANG_FULL ;;
    full) scripts/config -d LTO_NONE -d LTO_CLANG_THIN -e LTO_CLANG_FULL ;;
    *) _die "_use_llvm_lto '$_use_llvm_lto' is not one of none, thin, full" ;;
  esac

  scripts/config --set-str DRM_PANIC_SCREEN qr_code -e DRM_PANIC_SCREEN_QR_CODE \
    --set-str DRM_PANIC_SCREEN_QR_CODE_URL 'https://panic.archlinux.org/panic_report#' \
    --set-val DRM_PANIC_SCREEN_QR_VERSION 40

  make "${BUILD_FLAGS[@]}" olddefconfig
  diff -u ../config .config || :
  _check_config ../fiord.config

  make "${BUILD_FLAGS[@]}" -s kernelrelease > version
  [ "$(<version)" = "${_kernver}-fiord" ] || _die "unexpected kernel release $(<version)"
  msg2 "Prepared $pkgbase version $(<version)"
}

build() {
  cd "$_srcname"
  make "${BUILD_FLAGS[@]}" -j"$(nproc)" all
}

package_linux-fiord() {
  depends=('coreutils' 'kmod' 'initramfs')
  optdepends=('wireless-regdb: to set the correct wireless channels of your country'
              'linux-firmware: firmware images needed for some devices'
              'scx-scheds: to use sched-ext schedulers')
  provides=(VIRTUALBOX-GUEST-MODULES WIREGUARD-MODULE KSMBD-MODULE V4L2LOOPBACK-MODULE NTSYNC-MODULE VHBA-MODULE ADIOS-MODULE)

  cd "$_srcname"
  local modulesdir
  modulesdir="$pkgdir/usr/lib/modules/$(<version)"

  install -Dm644 "$(make "${BUILD_FLAGS[@]}" -s image_name)" "$modulesdir/vmlinuz"
  echo "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"

  ZSTD_CLEVEL=19 make "${BUILD_FLAGS[@]}" -j"$(nproc)" INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=/doesnt/exist modules_install

  rm "$modulesdir/build"

  install -Dm644 "$srcdir/70-linux-fiord.conf" "$pkgdir/usr/lib/sysctl.d/70-linux-fiord.conf"
}

package_linux-fiord-headers() {
  pkgdesc="Headers and scripts for building modules for the $pkgbase kernel"
  depends=(binutils glibc libelf libgcc openssl pahole xxhash zlib zstd "$pkgbase=$_kernver")
  provides=(LINUX-HEADERS)
  if [ "$_use_llvm_lto" != none ]; then
    depends+=("${_lto_deps[@]}")
  fi

  cd "$_srcname"
  local builddir
  builddir="$pkgdir/usr/lib/modules/$(<version)/build"

  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
    localversion.* version vmlinux
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/x86" -m644 arch/x86/Makefile
  cp -t "$builddir" -a scripts
  ln -srt "$builddir" "$builddir/scripts/gdb/vmlinux-gdb.py"

  install -Dt "$builddir/tools/objtool" tools/objtool/objtool
  if [ -f tools/bpf/resolve_btfids/resolve_btfids ]; then
    install -Dt "$builddir/tools/bpf/resolve_btfids" tools/bpf/resolve_btfids/resolve_btfids
  fi

  cp -t "$builddir" -a include
  cp -t "$builddir/arch/x86" -a arch/x86/include
  install -Dt "$builddir/arch/x86/kernel" -m644 arch/x86/kernel/asm-offsets.s

  install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
  install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h
  install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h
  install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
  install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
  install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h
  install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h

  find . -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;

  if compgen -G "rust/*.rmeta" >/dev/null; then
    install -Dt "$builddir/rust" -m644 rust/*.rmeta
  fi
  if compgen -G "rust/*.so" >/dev/null; then
    install -Dt "$builddir/rust" rust/*.so
  fi
  if [ -d rust/kernel ]; then
    local gen
    while IFS= read -r -d '' gen; do
      install -Dm644 "$gen" "$builddir/$gen"
    done < <(find rust -type f -name 'generated_*.rs' -print0)
  fi

  make "${BUILD_FLAGS[@]}" INSTALL_MOD_PATH="$pkgdir/usr" vdso_install link=

  local a
  for a in "$builddir"/arch/*/; do
    [[ $a = */x86/ ]] && continue
    rm -r "$a"
  done

  rm -r "$builddir/Documentation"
  rm -rf "$builddir/scripts/sbom"
  find -L "$builddir" -type l -printf 'Removing %P\n' -delete
  find "$builddir" -type f -name '*.o' -printf 'Removing %P\n' -delete

  local file
  while IFS= read -r -d '' file; do
    case "$(file -Sib "$file")" in
      application/x-sharedlib\;*) strip -v --strip-unneeded "$file" ;;
      application/x-archive\;*) strip -v --strip-debug "$file" ;;
      application/x-executable\;*) strip -v --strip-all "$file" ;;
      application/x-pie-executable\;*) strip -v --strip-unneeded "$file" ;;
    esac
  done < <(find "$builddir" -type f -perm -u+x ! -name vmlinux -print0)

  strip -v --strip-debug "$builddir/vmlinux"

  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}
