pkgname=crest
epoch=2
pkgver=1.0.1
pkgrel=3
pkgdesc="Fiordland desktop shell for Hyprland, written in QML for Quickshell"
arch=('any')
url='https://fiordlandlinux.org'
license=('GPL-3.0-only')
depends=('quickshell' 'qt6-declarative' 'qt6-imageformats' 'qt6-svg' 'hyprland'
         'matugen' 'hyprsunset' 'brightnessctl' 'wl-clipboard'
         'networkmanager' 'bluez' 'upower' 'power-profiles-daemon' 'pipewire'
         'ttf-material-symbols-variable' 'inter-font' 'ttf-jetbrains-mono'
         'grim' 'slurp' 'cliphist' 'wf-recorder' 'libnotify' 'xdg-user-dirs'
         'cava' 'gnome-keyring' 'libsecret' 'seahorse' 'xdg-utils'
         'procps-ng' 'bash' 'coreutils' 'findutils' 'systemd')
optdepends=('fprintd: fingerprint unlock for the lock screen'
            'noto-fonts-emoji: colour emoji in the launcher'
            'libpulse: record desktop audio with screen recordings'
            'kitty: terminal colours that follow the shell')
conflicts=('caelestia-shell' 'caelestia-shell-git')
replaces=('caelestia-shell')
source=("crest-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd crest
  install -d "$pkgdir/etc/xdg/quickshell/crest"
  cp -r --no-preserve=ownership,mode assets components config modules services theme utils shell.qml \
    "$pkgdir/etc/xdg/quickshell/crest/"
  find "$pkgdir/etc/xdg/quickshell/crest" -type d -exec chmod 755 {} +
  find "$pkgdir/etc/xdg/quickshell/crest" -type f -exec chmod 644 {} +
  install -Dm644 README.md "$pkgdir/usr/share/doc/crest/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
