pkgname=tawaki
pkgver=1.0.1
pkgrel=1
pkgdesc="The Fiordland Linux package manager"
arch=('x86_64')
url="https://github.com/Fiordland-Linux/tawaki"
license=('GPL-3.0-only')
depends=('pacman' 'gcc-libs' 'glibc')
optdepends=('flatpak: Flathub apps'
            'base-devel: AUR installs'
            'pacman-contrib: update counts')
makedepends=('cargo')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('ea1b2fa7f1882245b66aed28a5dac75f2e5c6d1b1dfcaf628cde43c1010ac914')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --frozen
}

package() {
  install -Dm755 "$srcdir/target/release/tawaki" "$pkgdir/usr/bin/tawaki"
  install -Dm644 "$srcdir/$pkgname-$pkgver"/dist/tawaki-catalogue.{service,timer} -t "$pkgdir/usr/lib/systemd/system/"
}
