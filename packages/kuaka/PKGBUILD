pkgname=kuaka
pkgver=1.0.2
pkgrel=1
pkgdesc="The Fiordland Linux update app"
arch=('x86_64')
url="https://github.com/Fiordland-Linux/kuaka"
license=('GPL-3.0-only')
depends=('tawaki>=1.0.0' 'pacman-contrib' 'snapper' 'polkit' 'gcc-libs' 'glibc'
         'fontconfig' 'freetype2' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libglvnd'
         'libx11' 'libxcursor' 'libxrandr' 'libxi')
optdepends=('flatpak: Flathub app updates'
            'ttf-material-symbols-variable: full icon set'
            'snap-pac: snapshots around every pacman transaction')
makedepends=('cargo')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('c93febf32e6db9b49be3749c0285f234311e4a33e714f96d301d7d492d277ba6')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$srcdir/target/release/kuaka" "$pkgdir/usr/bin/kuaka"
  install -Dm755 dist/kuaka-helper "$pkgdir/usr/lib/kuaka/kuaka-helper"
  install -Dm644 dist/lat.apollo44.kuaka.policy "$pkgdir/usr/share/polkit-1/actions/lat.apollo44.kuaka.policy"
  install -Dm644 dist/kuaka.desktop "$pkgdir/usr/share/applications/kuaka.desktop"
  install -Dm644 dist/kuaka-tray.desktop "$pkgdir/etc/xdg/autostart/kuaka-tray.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
