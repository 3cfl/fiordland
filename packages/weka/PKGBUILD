pkgname=weka
pkgver=1.0.2
pkgrel=1
pkgdesc="Swap Fiordland desktops and window managers cleanly"
arch=('any')
url="https://github.com/Fiordland-Linux/weka"
license=('GPL-3.0-only')
depends=('python' 'pyside6' 'qt6-wayland' 'polkit' 'pacman' 'inter-font' 'ttf-jetbrains-mono')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('b58348b3a45d6811d4fe761811e38e3861468bac2c33882ac1ca8f28bec83496')

package() {
  local s="$srcdir/$pkgname-$pkgver"
  install -Dm644 "$s/backend.py" "$s/plan.py" "$s/desktops.py" "$s/userconf.py" -t "$pkgdir/usr/lib/weka/"
  install -Dm755 "$s/weka.py" "$pkgdir/usr/lib/weka/weka.py"
  install -Dm755 "$s/weka-helper" "$pkgdir/usr/lib/weka/weka-helper"
  install -Dm644 "$s"/qml/* -t "$pkgdir/usr/lib/weka/qml/"
  install -Dm644 "$s/dist/lat.apollo44.weka.policy" "$pkgdir/usr/share/polkit-1/actions/lat.apollo44.weka.policy"
  install -Dm644 "$s/dist/weka.desktop" "$pkgdir/usr/share/applications/weka.desktop"
  install -dm755 "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec python3 /usr/lib/weka/weka.py "$@"\n' > "$pkgdir/usr/bin/weka"
  chmod 755 "$pkgdir/usr/bin/weka"
}
