pkgname=linux-wallpaperengine
_commit=a0ddce586e9ff12e9d31ca6b103f6036cc1b68fe
_cef=135.0.17+gcbc1c5b+chromium-135.0.7049.52
pkgver=0.0.1.r643.a0ddce5
pkgrel=2
pkgdesc="Renders Wallpaper Engine scene, video and web wallpapers on Linux"
arch=('x86_64')
url="https://github.com/Almamu/linux-wallpaperengine"
license=('GPL-3.0-only')
depends=('lz4' 'ffmpeg' 'mpv' 'glfw' 'glew' 'freeglut' 'libpulse' 'libcups' 'at-spi2-core'
         'nss' 'nspr' 'libxcomposite' 'libxdamage' 'sdl2' 'wayland' 'libglvnd' 'dbus'
         'alsa-lib' 'pango' 'cairo' 'glib2' 'mesa' 'expat' 'freetype2' 'libx11' 'libxcb'
         'libxext' 'libxfixes' 'libxrandr' 'libxkbcommon' 'systemd-libs')
makedepends=('git' 'cmake' 'glm' 'wayland-protocols' 'xorg-xrandr')
provides=("linux-wallpaperengine=$pkgver")
conflicts=('linux-wallpaperengine-git')
options=('!lto' '!debug')
source=("$pkgname::git+https://github.com/Almamu/linux-wallpaperengine.git#commit=$_commit"
        "glslang-WallpaperEngine::git+https://github.com/Almamu/glslang-WallpaperEngine.git"
        "SPIRV-Cross-WallpaperEngine::git+https://github.com/Almamu/SPIRV-Cross-WallpaperEngine.git"
        "stb::git+https://github.com/nothings/stb.git"
        "json::git+https://github.com/nlohmann/json.git"
        "MimeTypes::git+https://github.com/lasselukkari/MimeTypes.git"
        "kissfft::git+https://github.com/mborgerding/kissfft.git"
        "argparse::git+https://github.com/p-ranav/argparse.git"
        "Catch2::git+https://github.com/catchorg/Catch2.git"
        "quickjs::git+https://github.com/quickjs-ng/quickjs.git"
        "cef_binary_${_cef}_linux64_minimal.tar.bz2::https://cef-builds.spotifycdn.com/cef_binary_${_cef//+/%2B}_linux64_minimal.tar.bz2"
        "pause-signals.patch"
        "media-without-dbus.patch")
noextract=("cef_binary_${_cef}_linux64_minimal.tar.bz2")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            '24ac1980e62be7b1aea2c337d6bd4bc770dccd8b37e47c6db94b397f13ec4dc6'
            '19f9527b9dd0f0edced353fb468b9062e1dfdbcc29c27789c111cfcf34f1c305'
            'c7c35aa2f51368904c999c31bca633dfc1cfc75bd42597a7ae2e05cc3607750c')

prepare() {
  cd "$pkgname"
  local m
  for m in glslang-WallpaperEngine SPIRV-Cross-WallpaperEngine stb json MimeTypes kissfft argparse Catch2 quickjs; do
    git submodule init "src/External/$m"
    git config "submodule.src/External/$m.url" "$srcdir/$m"
  done
  git -c protocol.file.allow=always submodule update
  patch -Np1 -i "$srcdir/pause-signals.patch"
  patch -Np1 -i "$srcdir/media-without-dbus.patch"
  mkdir -p "$srcdir/build/cef"
  ln -sf "$srcdir/cef_binary_${_cef}_linux64_minimal.tar.bz2" "$srcdir/build/cef/"
}

build() {
  cmake -B build -S "$pkgname" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="/opt/$pkgname" \
    -Wno-dev \
    -DCMAKE_C_FLAGS="-Wno-builtin-macro-redefined" \
    -DCMAKE_CXX_FLAGS="-ffat-lto-objects -Wno-builtin-macro-redefined"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  local o="$pkgdir/opt/$pkgname"
  rm -rf "${o:?}"/{api-test,bm_*,*-float,function_source,glslang,glslangValidator,qjs,qjsc,run-test262,spirv-cross,spirv-remap,bin,include,share} \
    "$o"/lib/{cmake,pkgconfig} "$o"/lib/*.a
  chmod 755 "$o/$pkgname"
  install -d "$pkgdir/usr/bin"
  printf '%s\n' '#!/bin/sh' \
    "export LD_LIBRARY_PATH=\"/opt/$pkgname/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}\"" \
    "cd /opt/$pkgname || exit 1" \
    "exec ./$pkgname \"\$@\"" > "$pkgdir/usr/bin/$pkgname"
  chmod 755 "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
