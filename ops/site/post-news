def vkey(path):
    return tuple(int(p) for p in path.stem.split("."))


def render_post(path):
    lines = [l.rstrip() for l in path.read_text(encoding="utf-8").splitlines()]
    lines = [l for l in lines if l.strip()]
    title = lines[0] if lines else f"Fiordland {path.stem}"
    posted = time.strftime("%Y-%m-%d", time.gmtime(path.stat().st_mtime))
    out = [f'  <section class="msec" id="v{path.stem}">',
           f'    <h2 class="h3">{html.escape(title)}</h2>',
           f'    <p class="eyebrow">{posted} &middot; <a href="/news/{path.name}">plain text</a></p>']
    bullets = []

    def flush():
        if bullets:
            out.append('    <ul class="dlist">' + "".join(f"<li>{html.escape(b)}</li>" for b in bullets) + "</ul>")
            bullets.clear()

    for line in lines[1:]:
        if line.startswith("- "):
            bullets.append(line[2:].strip())
        else:
            flush()
            out.append(f"    <p>{html.escape(line.strip())}</p>")
    flush()
    out.append("  </section>")
    return "\n".join(out)


def posts():
    return sorted((p for p in NEWS.glob("*.txt") if VERSION.match(p.stem)), key=vkey, reverse=True)


def write(path, text):
    tmp = path.with_name("." + path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    st = (path if path.exists() else path.parent).stat()
    os.chown(tmp, st.st_uid, st.st_gid)
    os.chmod(tmp, 0o644)
    tmp.replace(path)


def point_home_page_at(version):
    index = SITE / "index.html"
    text = index.read_text(encoding="utf-8")
    shown = re.sub(r"(\.0)+$", "", version)
    text, a = re.subn(r'<a class="badge" href="[^"]*">(<span class="dot"></span><span class="shine">)Fiordland [0-9.]+ ',
                      rf'<a class="badge" href="/news/#v{version}">\g<1>Fiordland {shown} ', text)
    text, b = re.subn(r'"softwareVersion":"[^"]*"', f'"softwareVersion":"{version}"', text)
    if not (a and b):
        sys.exit("post-news: couldn't find the version badge on the home page; it may have been redesigned.")
    write(index, text)


def ensure_links():
    index = SITE / "index.html"
    text = index.read_text(encoding="utf-8")
    if 'href="/news/">News</a>' not in text:
        text = text.replace('    <a href="/docs/">Docs</a>\n    <a href="/wiki/">Wiki</a>\n    <a href="/mirrors/">',
                            '    <a href="/news/">News</a>\n    <a href="/docs/">Docs</a>\n    <a href="/wiki/">Wiki</a>\n    <a href="/mirrors/">', 1)
        write(index, text)
    sitemap = SITE / "sitemap.xml"
    sm = sitemap.read_text(encoding="utf-8")
    today = time.strftime("%Y-%m-%d", time.gmtime())
    if "/news/</loc>" in sm:
        sm = re.sub(r"(<loc>https://fiordlandlinux.org/news/</loc><lastmod>)[^<]*", rf"\g<1>{today}", sm)
    else:
        sm = sm.replace("</urlset>", f"  <url><loc>https://fiordlandlinux.org/news/</loc><lastmod>{today}</lastmod></url>\n</urlset>")
    write(sitemap, sm)


def rebuild():
    write(NEWS / "index.html", PAGE.replace("{posts}", "\n".join(render_post(p) for p in posts())))
    ensure_links()


def commit(message):
    if subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--git-dir"], capture_output=True).returncode:
        return
    subprocess.run(["git", "-C", str(ROOT), "add", "site/news", "site/index.html", "site/sitemap.xml"], check=True)
    if subprocess.run(["git", "-C", str(ROOT), "commit", "-q", "-m", message]).returncode == 0:
        print("Committed to git.")


def main():
    ap = argparse.ArgumentParser(
        description="Post Fiordland release notes and rebuild /news/.",
        epilog='Notes are plain text: the first line is the title, lines starting with "- " become bullets, '
               "other lines become paragraphs. Saved as site/news/<version>.txt; the home page badge points at "
               "the newest version. Use - as the notes file to read from stdin.",
    )
    ap.add_argument("version", nargs="?")
    ap.add_argument("notes", nargs="?", help="text file, or - for stdin")
    ap.add_argument("--rebuild", action="store_true", help="only rebuild the news page")
    ap.add_argument("--force", action="store_true", help="replace notes that already exist")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    if args.rebuild:
        rebuild()
        commit("Rebuild news page")
        print("Rebuilt /news/.")
        return
    if not (args.version and args.notes):
        ap.error("give a version and a notes file (or --rebuild)")
    if not VERSION.match(args.version):
        ap.error("version should look like 0.9.2")

    text = sys.stdin.read() if args.notes == "-" else Path(args.notes).read_text(encoding="utf-8")
    text = text.replace("\r\n", "\n").strip() + "\n"
    if len(text.strip().splitlines()) < 2:
        sys.exit("post-news: notes need a title line and at least one more line.")
    target = NEWS / f"{args.version}.txt"
    if target.exists() and not args.force:
        sys.exit(f"post-news: {target.name} already exists. Use --force to replace it.")
    newest = posts()[0].stem if posts() else None
    becomes_latest = newest is None or vkey(target) >= vkey(NEWS / f"{newest}.txt")

    print(f"Would write site/news/{target.name}:\n" + "".join("  " + l + "\n" for l in text.splitlines()))
    print("Home page badge -> " + (f"Fiordland {args.version}" if becomes_latest else f"unchanged (newest is {newest})"))
    if args.dry_run:
        print("Dry run, nothing changed.")
        return

    write(target, text)
    if becomes_latest:
        point_home_page_at(args.version)
    rebuild()
    commit(f"News: Fiordland {args.version}")
    print(f"Posted https://fiordlandlinux.org/news/#v{args.version}")


if __name__ == "__main__":
    main()
